# Cloudflare Pages headers (ignored by GitHub Pages, which is fine).
# Long-cache the hashed build assets.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# NOTE: if a future threaded WASM engine lands, uncomment to enable
# SharedArrayBuffer. The current Ghostscript build is single-threaded. These
# headers work on Cloudflare Pages but NOT GitHub Pages (which cannot set custom
# headers — it would need a coi-serviceworker shim there).
# /*
#   Cross-Origin-Opener-Policy: same-origin
#   Cross-Origin-Embedder-Policy: require-corp
