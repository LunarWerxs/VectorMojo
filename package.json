{
  "name": "vectormojo",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "description": "Client-side design-file to vector converter. 100% local compute, static-hostable (Cloudflare/GitHub Pages).",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "check:public": "bun run tools/check-public-assets.ts",
    "build": "bun run check:public && vue-tsc --noEmit && vite build && vite build --ssr src/entry-server.ts --outDir dist-ssr && bun run tools/prerender.ts && bun run tools/copy-license-assets.ts",
    "preview": "vite preview",
    "test": "bun test",
    "generate:sample": "bun run tools/generate-sample.ts",
    "probe": "bun run tools/probe-agpsd.ts"
  },
  "dependencies": {
    "@cnct/connect": "^1.5.2",
    "@jspawn/ghostscript-wasm": "0.0.2",
    "ag-psd": "^31.0.2",
    "imagetracerjs": "1.2.6",
    "jspdf": "^4.2.1",
    "mupdf": "^1.28.1",
    "pako": "^3.0.2",
    "polygon-clipping": "^0.15.7",
    "svg2pdf.js": "^2.8.1",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.1",
    "@types/pako": "^3.0.0",
    "@types/pngjs": "6.0.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "pngjs": "7.0.0",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  }
}
