{
  "name": "vectormojo",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Client-side design-file to vector converter. 100% local compute, static-hostable (Cloudflare/GitHub Pages).",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "check:public": "bun run tools/check-public-assets.ts",
    "build": "bun run check:public && vue-tsc --noEmit && vite build && bun run tools/copy-license-assets.ts",
    "preview": "vite preview",
    "test": "bun test",
    "generate:sample": "bun run tools/generate-sample.ts",
    "probe": "bun run tools/probe-agpsd.ts"
  },
  "dependencies": {
    "@cnct/connect": "^1.5.1",
    "@jspawn/ghostscript-wasm": "0.0.2",
    "ag-psd": "^31.0.2",
    "imagetracerjs": "1.2.6",
    "jspdf": "^4.2.1",
    "mupdf": "^1.28.1",
    "pako": "^2.2.0",
    "polygon-clipping": "^0.15.7",
    "svg2pdf.js": "^2.8.1",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/pako": "^2.0.4",
    "@types/pngjs": "6.0.5",
    "@vitejs/plugin-vue": "^5.2.4",
    "pngjs": "7.0.0",
    "svgo": "^3.3.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vue-tsc": "^2.2.12"
  }
}
